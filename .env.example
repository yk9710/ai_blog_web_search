# 复制为 .env 后填写自己的密钥；模型 ID 必须是当前账号可用的模型。
# 模型接入方式参考 ai_blog_search，但未复制该项目的密钥。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

QWEN_MODEL=qwen3.7-text-embedding
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=

# 可选配置：未填写时跳过网络搜索；本地资料不足时会明确提示。
TAVILY_API_KEY=
